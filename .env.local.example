# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
# Server only: bypasses row-level security. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=xxx

# Public address of the site (metadata, links)
NEXT_PUBLIC_SITE_URL=https://ton-domaine.vercel.app

# Address the downloaded Apple Shortcut posts to (defaults to the server that made it)
SHORTCUT_API_URL=https://ton-domaine.vercel.app

# Shared Shortcut on iCloud, if you publish one (optional)
NEXT_PUBLIC_SHORTCUT_ICLOUD_URL=

# Third-party APIs
NEWSAPI_KEY=xxx
LASTFM_API_KEY=xxx
