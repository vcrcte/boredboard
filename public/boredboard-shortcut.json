{
  "name": "BoredBoard Music",
  "description": "Documentation of the Apple Shortcut that shares the song playing in the Music app on BoredBoard. This is not an importable .shortcut file: build it in the Shortcuts app with these actions.",
  "endpoint": {
    "method": "POST",
    "path": "/api/shortcuts/music",
    "headers": { "Content-Type": "application/json" },
    "body": {
      "token": "Personal token from /raccourci (starts with bb_)",
      "title": "Song name (required)",
      "artist": "Artist (optional)",
      "platform": "apple | spotify (optional, default apple)"
    },
    "responses": {
      "200": { "success": true, "message": "\"<title>\" partagé sur BoredBoard !", "post_id": "<uuid>" },
      "400": { "error": "Titre requis" },
      "401": { "error": "Token requis | Token invalide" }
    }
  },
  "steps": [
    { "action": "Text", "parameters": { "text": "<Token BoredBoard>" }, "note": "Ask for it on first run, or paste the token here once." },
    { "action": "Get Current Song", "note": "Music app only. Spotify does not expose its current track to Shortcuts on iOS; use an 'Ask for Input' action for the title instead." },
    { "action": "Get Details of Music", "parameters": { "detail": "Name" } },
    { "action": "Get Details of Music", "parameters": { "detail": "Artist" } },
    {
      "action": "Get Contents of URL",
      "parameters": {
        "url": "https://boredboard.vercel.app/api/shortcuts/music",
        "method": "POST",
        "requestBody": "JSON",
        "json": { "token": "Text", "title": "Name", "artist": "Artist", "platform": "apple" }
      }
    },
    { "action": "Get Dictionary Value", "parameters": { "key": "message" } },
    { "action": "Show Notification", "parameters": { "body": "Dictionary Value" } }
  ]
}
